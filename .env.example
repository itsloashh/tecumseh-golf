# ── Site ───────────────────────────────────────────────
# Use the vercel.app address until the tecumsehgolf.com domain is pointed at Vercel
NEXT_PUBLIC_SITE_URL=https://tecumsehgolf.com

# ── Supabase (leave blank to run on the bundled sample data) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Staff ──────────────────────────────────────────────
# Owner/manager login(s), comma-separated. Employees are added in the dashboard under Team & access.
ADMIN_EMAILS=
# Local only: browse the admin UI on sample data without Supabase (ignored on Vercel)
ADMIN_DEMO=

# ── Email (optional) — alerts + customer receipts via resend.com (recipients are set in the dashboard) ──
RESEND_API_KEY=
# Fallback alert inbox if no one is added under Notifications
NOTIFY_TO=info@tecumsehgolf.com
NOTIFY_FROM=Tecumseh Golf <orders@tecumsehgolf.com>

# ── Card payments (optional) — leave blank for "reserve & pay at pickup" only ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
